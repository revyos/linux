config PHY_ZHIHE_A210_E16
	tristate "Zhihe A210 E16 PCIe PHY"
	depends on ARCH_ZHIHE || COMPILE_TEST
	depends on OF && COMMON_CLK
	select GENERIC_PHY
	help
	  Enable the shared Synopsys E16 PHY for the A210 PCIe root ports.
	  The driver configures lane routing and analog calibration using
	  the board reference clock. Both root ports share the PHY lifetime.
	  Say Y or M when using PCIe on a Zhihe A210 board.

config PHY_ZHIHE_A210_USB2
	tristate "Zhihe A210 USB2 PHY"
	depends on ARCH_ZHIHE || COMPILE_TEST
	depends on OF && COMMON_CLK
	select GENERIC_PHY
	select USB_COMMON
	help
	  Enable the two USB2 femtoPHY instances on the Zhihe A210.
	  Each PHY uses the connected controller's fixed host or device
	  role. Clock and reset resources are managed independently.
	  Say Y or M for boards using the A210 DWC2 controllers.

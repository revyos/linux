		uart4: serial@8401000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x00 0x08401000 0x0 0x400>;
			interrupt-parent = <&intc>;
			interrupts = <325 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_peri PERI2_UART4_SCLK_EN>, <&clk_peri PERI2_UART4_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
			/* Firmware has already configured the boot console UART. */

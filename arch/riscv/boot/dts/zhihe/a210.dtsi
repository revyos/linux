			compatible = "zhihe,a210-gpu", "img,img-bxm-4-64",
				     "img,img-rogue";
			reg = <0 0x06c00000 0 0x100000>;
			interrupt-parent = <&intc>;
			interrupts = <72 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_gpu SW_PWR_WRAP_GPU_CORE_CLK_EN>,
				 <&clk_gpu SW_PWR_WRAP_DFMU_CORE_CLK_EN>,
				 <&clk_gpu SW_PWR_WRAP_GPU_SYS_CLK_EN>;
			clock-names = "core", "mem", "sys";
			resets = <&rst_gpu GPU_PWR_WRAP_RGX_HOOD_RST>;
			power-domains = <&power_gpu>;
			status = "disabled";
		};

		clk_vo: clock-controller@6720200 {
			compatible = "zhihe,a210-vo-clk";
			reg = <0 0x06720200 0 0xc>, <0 0x06720048 0 4>;
			reg-names = "vo-clk", "vo-path-ctrl";
			#clock-cells = <1>;
		};

		dc8200: display@6400000 {
			compatible = "zhihe,a210-dc8200", "verisilicon,dc";
			reg = <0 0x06400000 0 0x10000>;
			interrupt-parent = <&intc>;
			interrupts = <218 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_vo VO_DPUC_CLK_EN>,
				 <&clk_vo VO_DPU_ACLK_EN>,
				 <&clk_vo VO_DPU_HCLK_EN>,
				 <&clk_vo VO_CH0_PIXCLK_EN>,
				 <&clk_vo VO_CH1_PIXCLK_EN>;
			clock-names = "core", "axi", "ahb", "pix0", "pix1";
			resets = <&rst_vo VO_DPU_CRST>, <&rst_vo VO_DPU_ARST>,
				 <&rst_vo VO_DPU_HRST>;
			reset-names = "core", "axi", "ahb";
			power-domains = <&power_vo>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
					dc8200_hdmi_out: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&hdmi_in>;
					};
				};
			};
		};

		hdmi: hdmi@6600000 {
			compatible = "zhihe,a210-dw-hdmi";
			reg = <0 0x06600000 0 0x40000>;
			reg-io-width = <4>;
			interrupt-parent = <&intc>;
			interrupts = <216 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_vo VO_HDMI_PCLK_EN>,
				 <&clk_vo VO_HDMI_SFRCLK_EN>,
				 <&clk_vo VO_CEC_CLK_EN>,
				 <&clk_vo VO_HDMI_PIXCLK>;
			clock-names = "iahb", "isfr", "cec", "pix";
			resets = <&rst_vo VO_HDMI_MAIN_RST>,
				 <&rst_vo VO_HDMI_PRST>;
			reset-names = "main", "apb";
			power-domains = <&power_vo>;
			assigned-clocks = <&clk_vo VO_HDMI_PIXCLK>;
			assigned-clock-parents = <&clk_vo VO_CH1_PIXCLK_EN>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					hdmi_in: endpoint {
						remote-endpoint = <&dc8200_hdmi_out>;
					};
				};
				port@1 {
					reg = <1>;
					hdmi_out: endpoint { };
				};
			};
		};


			reg = <0x00 0x02017000 0x0 0x1000>;
			interrupt-parent = <&intc>;
			interrupts = <324 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_peri PERI1_UART3_SCLK_EN>, <&clk_peri PERI1_UART3_PCLK_EN>;
			clock-names = "baudclk", "apb_pclk";
